{
    "name": "modufolio/panel",
    "description": "Schema-driven admin panel for Appkit: resources, table schemas, drawers and blueprint forms, emitted as JSON for @modufolio/panel to render.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Maarten Thiebou"
        }
    ],
    "require": {
        "php": ">=8.3",
        "doctrine/orm": "^3.0",
        "modufolio/appkit": "*",
        "modufolio/json-api": "*",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "ramsey/uuid": "^4.7",
        "symfony/options-resolver": "^7.0",
        "symfony/routing": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Modufolio\\Panel\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Modufolio\\Panel\\Tests\\": "tests/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../appkit",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../psr7",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../json-api",
            "options": {
                "symlink": true
            }
        }
    ],
    "scripts": {
        "test": "phpunit",
        "stan": "@php -d memory_limit=1G vendor/bin/phpstan analyse"
    }
}
